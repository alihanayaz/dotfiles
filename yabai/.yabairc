#!/usr/bin/env sh

yabai -m config                                 \
    layout                       bsp            \
    window_placement             second_child   \
    top_padding                  06             \
    bottom_padding               06             \
    left_padding                 06             \
    right_padding                06             \
    window_gap                   06             \
    mouse_follows_focus          off            \
    mouse_modifier               alt            \
    mouse_action1                move           \
    mouse_action2                resize         \
    mouse_drop_action            swap
